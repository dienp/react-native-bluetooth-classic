{
  "name": "@dynlabs/react-native-bluetooth-classic",
  "version": "2.0.0-alpha.0",
  "description": "Bluetooth Classic (RFCOMM/SPP) on Android and MFi ExternalAccessory sessions on iOS for React Native's new architecture",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-bluetooth-classic-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./jest": {
      "react-native-bluetooth-classic-source": "./src/jest.ts",
      "types": "./lib/typescript/src/jest.d.ts",
      "default": "./lib/module/jest.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "*.podspec",
    "app.plugin.js",
    "plugin/build",
    "!ios/build",
    "!ios/Core/.build",
    "!ios/Core/.swiftpm",
    "!ios/Core/Tests",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!android/src/test",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace react-native-bluetooth-classic-example",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build && tsc -p plugin",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "test": "jest",
    "test:android": "cd example/android && ./gradlew :dynlabs_react-native-bluetooth-classic:testDebugUnitTest --console=plain",
    "test:report": "bash scripts/test-report.sh",
    "openspec:validate": "openspec validate --all --strict",
    "release": "release-it",
    "release:rc": "release-it --preRelease=rc --npm.tag=next",
    "errors:generate": "node scripts/generate-error-codes.mjs",
    "errors:check": "node scripts/generate-error-codes.mjs --check",
    "build:plugin": "tsc -p plugin"
  },
  "keywords": [
    "react-native",
    "bluetooth",
    "bluetooth-classic",
    "rfcomm",
    "spp",
    "serial",
    "external-accessory",
    "mfi",
    "android",
    "ios",
    "turbo-module"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dienp/react-native-bluetooth-classic.git"
  },
  "author": "Kenneth Davidson <ken.j.davidson@live.ca> (https://github.com/kenjdavidson)",
  "contributors": [
    "Jakub Marty\u010d\u00e1k <martycakjakub@gmail.com> (https://github.com/rusel1989)",
    "Tony Lara <tony.lara.p@gmail.com> (https://github.com/tonyl)",
    "redloro@gmail.com (https://github.com/redloro)",
    "iamandiradustefan@gmail.com (https://github.com/iamandiradu)",
    "Andrew Krugliak (https://github.com/andreykrugliak)",
    "Anton Petrov (https://github.com/tpettrov)",
    "Stephen Woodruff (https://github.com/woodrufs)",
    "Phil Pettican (https://github.com/philpettican)",
    "Mark Ormandy <mark.ormandy@myracelab.com>(https://github.com/myracelab)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/dienp/react-native-bluetooth-classic/issues"
  },
  "homepage": "https://github.com/dienp/react-native-bluetooth-classic#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "^58.0.11",
    "@fission-ai/openspec": "1.15.0",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "release-it": "^21.1.1",
    "test-renderer": "^1.3.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*",
    "react": "*",
    "react-native": ">=0.82.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "jest": {
    "preset": "@react-native/jest-preset",
    "roots": [
      "<rootDir>/src",
      "<rootDir>/example/src",
      "<rootDir>/plugin/src"
    ],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/example/src/**/__tests__/**/*.test.{ts,tsx}",
      "<rootDir>/plugin/src/**/__tests__/**/*.test.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ],
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/__tests__/**",
      "!src/specs/**"
    ],
    "moduleNameMapper": {
      "^@dynlabs/react-native-bluetooth-classic/jest$": "<rootDir>/src/jest.ts",
      "^@dynlabs/react-native-bluetooth-classic$": "<rootDir>/src/index.ts",
      "^react$": "<rootDir>/node_modules/react",
      "^react/(.*)$": "<rootDir>/node_modules/react/$1",
      "^react-native$": "<rootDir>/node_modules/react-native"
    }
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNBluetoothClassicSpec",
    "type": "modules",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "kjd.reactnative.bluetooth"
    },
    "ios": {
      "modulesProvider": {
        "RNBluetoothClassic": "RNBluetoothClassic"
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        },
        "infile": "CHANGELOG.md"
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "eslint",
      "jest",
      "release-it"
    ],
    "version": "0.64.0"
  }
}
